# Same Supabase project as the website — copy the values from the root .env.
# Note the EXPO_PUBLIC_ prefix: it is required for the value to reach the app,
# and it also means the value is embedded in the binary and readable by anyone.
# Treat that prefix as a warning label. Never put a service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Google OAuth client IDs — public by design (they identify the app, not authorise it).
# The WEB client is what Supabase validates against; the iOS one is what the device presents.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com
