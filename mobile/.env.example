# Same Supabase project as the website — copy the values from the root .env.
# Note the EXPO_PUBLIC_ prefix: it is required for the value to reach the app,
# and it also means the value is embedded in the binary and readable by anyone.
# Treat that prefix as a warning label. Never put a service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Development only: opt in when reviewing onboarding; normal dev reloads restore the session.
# EXPO_PUBLIC_REPLAY_ONBOARDING=1

# Google OAuth client IDs — public by design (they identify the app, not authorise it).
# The WEB client is what Supabase validates against; the iOS one is what the device presents.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com

# Google Maps SDK for Android: restrict this public key to com.fourmpadel.app,
# the test/store signing certificate SHA-1 values, and Maps SDK for Android.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=your_android_maps_api_key

# Use the same PostHog project as the website.
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_TELEMETRY_ENV=

# Sentry source maps and iOS symbols (EAS build environment only).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=
