<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
  <application>
    <service android:name="expo.modules.notifications.service.ExpoFirebaseMessagingService" tools:node="remove" />
    <service android:name=".LiveScoreMessagingService" android:exported="false">
      <intent-filter android:priority="-1">
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
    <receiver android:name=".UnpinLiveScoreReceiver" android:exported="false" />
  </application>
</manifest>
