{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "headers": [
    {
      "source": "/((?!private-draw-rehearsal/).*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/private-draw-rehearsal/:path*",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/admin",
      "destination": "https://4mpadel.co.za/admin",
      "permanent": false
    },
    {
      "source": "/calendar/:path*",
      "destination": "https://4mpadel.co.za/calendar/:path*",
      "permanent": false
    },
    {
      "source": "/players/:path*",
      "destination": "https://4mpadel.co.za/players/:path*",
      "permanent": false
    },
    {
      "source": "/gallery/:path*",
      "destination": "https://4mpadel.co.za/gallery/:path*",
      "permanent": false
    },
    {
      "source": "/clubs/:path*",
      "destination": "https://4mpadel.co.za/clubs/:path*",
      "permanent": false
    },
    {
      "source": "/organisations/:path*",
      "destination": "https://4mpadel.co.za/organisations/:path*",
      "permanent": false
    },
    {
      "source": "/federations/:path*",
      "destination": "https://4mpadel.co.za/federations/:path*",
      "permanent": false
    },
    {
      "source": "/profile",
      "destination": "https://4mpadel.co.za/profile",
      "permanent": false
    },
    {
      "source": "/contact",
      "destination": "https://4mpadel.co.za/contact",
      "permanent": false
    },
    {
      "source": "/results/:path*",
      "destination": "https://4mpadel.co.za/results/:path*",
      "permanent": false
    },
    {
      "source": "/draws/:path*",
      "destination": "https://4mpadel.co.za/draws/:path*",
      "permanent": false
    },
    {
      "source": "/draws-preview/:path*",
      "destination": "https://4mpadel.co.za/draws-preview/:path*",
      "permanent": false
    },
    {
      "source": "/native-draws/:path*",
      "destination": "https://4mpadel.co.za/native-draws/:path*",
      "permanent": false
    },
    {
      "source": "/reset-password",
      "destination": "https://4mpadel.co.za/reset-password",
      "permanent": false
    },
    {
      "source": "/claim-club",
      "destination": "https://4mpadel.co.za/claim-club",
      "permanent": false
    },
    {
      "source": "/events/:path*",
      "destination": "https://4mpadel.co.za/events/:path*",
      "permanent": false
    },
    {
      "source": "/blog/:path*",
      "destination": "https://4mpadel.co.za/blog/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/admin-review.html"
    },
    {
      "source": "/admin-preview/:path*",
      "destination": "/admin-review.html"
    }
  ]
}
